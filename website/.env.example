### Application environment (copy to .env and adjust for production)

# General
NODE_ENV=production

# Database (PostgreSQL)
POSTGRES_USER=salon_user
POSTGRES_PASSWORD=change-this-password
POSTGRES_DB=salon_db

# Backend database connection (inside Docker network)
DB_HOST=db
DB_PORT=5432
DB_USER=${POSTGRES_USER}
DB_PASSWORD=${POSTGRES_PASSWORD}
DB_NAME=${POSTGRES_DB}

# Backend service
BACKEND_PORT=3001

# CORS / frontend origin
# For local development:
CORS_ORIGIN=http://localhost:3000
# For production (example):
# CORS_ORIGIN=https://your-salon-domain.dk

# JWT secret for signing auth tokens
# Use a long, random string in real deployments.
JWT_SECRET=change-this-to-a-long-random-secret

# Admin account (email that can access /admin) — must match the Google account you log in with
ADMIN_EMAIL=your-admin@gmail.com

# Automatic backup log used by the admin backup status
BACKUP_LOG_PATH=/var/log/backup.log

# E-mail verification (Resend — https://resend.com)
RESEND_API_KEY=re_xxxxxxxx
# Must be a verified sender/domain in Resend, e.g. Booking <onboarding@resend.dev> for tests
RESEND_FROM="Nordisk Hår <onboarding@resend.dev>"

# Google Calendar one-way sync (service account)
GOOGLE_CALENDAR_ENABLED=false
GOOGLE_CALENDAR_ID=your-calendar-id@group.calendar.google.com
GOOGLE_SERVICE_ACCOUNT_EMAIL=calendar-sync@your-project.iam.gserviceaccount.com
# Keep this only on the VM/.env. Use \n for newlines in Docker env files.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_CALENDAR_TIMEZONE=Europe/Copenhagen


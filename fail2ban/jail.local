[DEFAULT]
bantime = 1h
findtime = 10m
maxretry = 5
backend = auto

[sshd]
enabled = true
port = 22
filter = sshd
logpath = /var/log/auth.log
bantime = 1h
findtime = 10m
maxretry = 5

[nginx-4xx]
enabled = true
port = http,https
filter = nginx-4xx
logpath = /var/log/nginx/access.log
bantime = 1h
findtime = 10m
maxretry = 20
